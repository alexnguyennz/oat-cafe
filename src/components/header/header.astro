---
import { Image } from "astro:assets";

import { MobileMenu } from "./mobile-menu.tsx";

import { cn } from "@/lib/utils";
import { links } from "@/lib/data";

const pathname = Astro.url.pathname;
---

<header
  transition:animate="none"
  class="sticky top-0 z-40 w-full bg-black font-serif text-white"
>
  <a href="/" class="my-3 flex justify-center">
    <Image
      id="logo"
      src={import("../../assets/img/logo.png")}
      width="250"
      alt="Oat Café logo"
      class="h-auto w-28 object-cover"
      loading="eager"
    />
  </a>

  <nav class="relative flex items-center justify-center pb-3">
    {
      pathname === "/" && (
        <a
          href="https://wellington.govt.nz/recreation/facilities-and-centres/akau-tangi-sports-centre"
          target="_blank"
          rel="noreferrer noopener nofollow"
          class="corner absolute top-full left-0 -mt-px size-34 overflow-hidden bg-gray-800 sm:size-36 md:size-48"
        >
          <Image
            src={import("../../assets/img/akau-tangi.png")}
            width="250"
            alt="Akau Tangi Sports Centre logo"
            class="relative z-10 size-20 md:size-24 lg:size-28"
            loading="eager"
          />
        </a>
      )
    }

    {
      pathname === "/" && (
        <a
          href="https://www.ubereats.com/nz/store/oat-cafe/Wm4KrAvQTueBU13tp67w7Q"
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="absolute top-full right-3 mt-3"
        >
          <Image
            id="logo"
            src={import("../../assets/img/uber/uber-eats-2.png")}
            width="350"
            alt="Uber Eats logo"
            class="mx-auto h-auto w-32 self-center"
            loading="eager"
          />
        </a>
      )
    }

    <ul class="hidden gap-3 text-lg md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class={cn(
                "relative isolate z-20 inline-flex overflow-hidden px-2 py-1 font-semibold uppercase transition-colors",
                "text-white before:absolute before:inset-x-0 before:bottom-0 before:z-0 before:h-0 before:bg-white before:content-['']",
                "before:transition-[height] before:duration-200 before:ease-out hover:text-black hover:before:h-full",
                link.href === "/"
                  ? pathname === "/" && "bg-white text-black before:h-full"
                  : pathname.startsWith(link.href) &&
                      "bg-white text-black before:h-full",
              )}
              data-astro-prefetch
            >
              <span class="relative z-10">{link.name}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <MobileMenu client:visible pathname={pathname} />
  </nav>
</header>

<style>
  .corner {
    clip-path: polygon(0 0, 0% 100%, 100% 0);
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  .corner::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to left, black, black);
    background-position: right;
    background-size: 0% 100%;
    background-repeat: no-repeat;
    transition: background-size 0.4s ease;
    z-index: 1;
  }

  .corner:hover::before,
  button:hover .corner::before {
    background-size: 100% 100%;
  }
</style>
