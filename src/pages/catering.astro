---
import { Image } from "astro:assets";

import { Icon } from "astro-icon/components";

import Layout from "../layouts/layout.astro";

import { CateringForm } from "@/components/pages/catering/catering-form.tsx";
---

<Layout title="Catering" full>
  <!-- Hero -->
  <div class="relative">
    <Image
      id="logo"
      src={import("../assets/img/pages/catering/hero.jpg")}
      width="1550"
      alt="catering hero"
      class="mx-auto h-auto max-h-150 w-full object-cover"
      loading="eager"
    />

    <div
      class="pointer-events-none absolute inset-0 bg-linear-to-t from-black/50 via-black/30 to-transparent"
    >
    </div>

    <div class="relative mx-auto max-w-4xl xl:max-w-7xl">
      <div class="absolute bottom-5 left-5 z-10 font-sans text-white">
        <h2 class="font-fancy text-9xl text-shadow-lg">Lock in</h2>
        <p class="mt-3 font-serif text-3xl">
          Good food, and carefree experience await!
        </p>
      </div>
    </div>
  </div>

  <!-- Booking -->
  <div class="bg-black p-5 text-white md:p-10">
    <div
      class="mx-auto flex max-w-7xl flex-col items-center justify-center gap-6 md:items-center lg:flex-row lg:gap-9 xl:gap-12"
    >
      <div
        class="bg-accent-lightYellow h-fit w-full max-w-xl space-y-3 self-center rounded-3xl p-10 text-xl text-black"
      >
        <h2 class="text-center font-serif text-2xl font-bold text-black">
          Disclaimer
        </h2>

        <p>
          All catering orders are <strong class="font-semibold"
            >request-only</strong
          >—we'll do our very best to accommodate your needs.
        </p>

        <ul class="ml-8 list-disc">
          <li>
            We require a <strong class="font-semibold"
              >5-day advance notice</strong
            >
            for all requests
          </li>
          <li>
            <strong class="font-semibold"
              >Guest allergens must be shared 48 hours before</strong
            > your booking
          </li>
          <li>
            For events <strong class="font-semibold">outside the café</strong>,
            room bookings must first be confirmed through the <strong
              class="font-semibold">Ākau Tangi Sports Centre</strong
            >—catering requests cannot be approved until this is done
          </li>
        </ul>

        <p class="text-center">
          We look forward to making your event a success!
        </p>
      </div>

      <div class="h-fit w-full max-w-xl space-y-6 self-center">
        <h2 class="text-accent-lightYellow font-serif text-2xl font-medium">
          Book your beat
        </h2>

        <CateringForm client:visible />
      </div>
    </div>
  </div>
</Layout>
