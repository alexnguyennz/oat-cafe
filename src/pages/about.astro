---
import { Image } from "astro:assets";

import Layout from "../layouts/layout.astro";

import { Gallery } from "@/components/pages/about/gallery.tsx";
---

<Layout title="About" full>
  <div class="relative min-h-155">
    <div class="absolute inset-0">
      <img src="/pages/about.jpg" alt="" class="h-full w-full object-cover" />
      <div
        class="absolute inset-0 bg-linear-to-b from-black/20 via-black/35 to-black/15"
      >
      </div>
    </div>

    <div
      class="relative z-10 mb-12 flex flex-col justify-center gap-10 px-5 text-white"
    >
      <div class="grid items-center gap-6 pt-24">
        <Image
          id="logo"
          src={import("../assets/img/logo.png")}
          width="550"
          alt="Oat Café logo"
          class="mx-auto h-auto w-84 object-cover"
          loading="eager"
        />
      </div>

      <div
        class="bg-accent-lightYellow mx-auto max-w-4xl space-y-6 p-5 text-black"
      >
        <h2
          class="text-primary-brown text-center font-serif text-4xl font-bold"
        >
          Our dedication to <span class="relative inline-block">
            you
            <svg
              class="text-primary-brown pointer-events-none absolute -bottom-2 left-1/2 h-3.5 w-[120%] -translate-x-1/2"
              viewBox="0 0 120 12"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                d="M2 9.2C18 8.1 34 6.4 50 5.6C66 4.8 82 3.2 98 2.4C108 1.8 114 2.1 118 1.6"
                stroke="currentColor"
                stroke-width="2.25"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </span>
        </h2>

        <p
          class="text-primary-brown/75 mx-auto max-w-5xl text-center font-serif text-2xl"
        >
          At Oat Café, we pride ourselves on being more than just a place to
          grab a quick bite—we're a family-friendly and child-friendly
          destination where friends gather and memories are made.
        </p>
      </div>
    </div>
  </div>

  <section class="bg-black py-12">
    <div
      class="relative mx-auto flex w-full max-w-4xl flex-1 flex-col justify-center gap-6 self-center rounded-3xl px-5 text-black xl:max-w-7xl"
    >
      <h2
        id="venue"
        class="text-center font-serif text-4xl font-bold text-balance text-white text-shadow-lg"
      >
        View our venue
      </h2>

      <Gallery client:visible />
    </div>
  </section>

  <div class="bg-accent-lightYellow relative py-12">
    <div
      class="relative z-10 mx-auto flex w-full max-w-4xl flex-1 flex-col justify-center gap-6 self-center rounded-3xl px-5 text-black xl:max-w-7xl"
    >
      <div class="flex flex-col items-center justify-center gap-6 md:flex-row">
        <h2
          class="text-center font-serif text-4xl font-bold text-black md:text-balance"
        >
          Proudly owned by Yellow Seat
        </h2>

        <Image
          id="logo"
          src={import("../assets/img/yellowseat-chair.png")}
          width="250"
          alt="Yellow Seat logo"
          class="h-auto w-12 object-cover"
          loading="eager"
        />
      </div>

      <div class="max-w-xl bg-neutral-800">
        <p class="p-5 font-serif text-2xl text-white">
          Yellow Seat was founded out of a love of cuisine, our passion for
          service, and a drive to excel in the industry. We take great pleasure
          in being able to produce almost any delectable dish you can think of
          and deliver it with unmatched service.
        </p>

        <a href="https://theseats.co.nz" target="_blank" class="block w-full">
          <Image
            id="logo"
            src={import("../assets/img/yellowseat.png")}
            width="550"
            alt="Yellow Seat logo"
            class="block h-auto w-full bg-white object-cover p-5"
            loading="eager"
          />
        </a>
      </div>
    </div>

    <Image
      id="logo"
      src={import("../assets/img/pages/about/proudly-owned.png")}
      width="1550"
      alt=""
      class="absolute right-0 bottom-0 mx-auto h-auto w-1/2 max-w-250 object-contain"
      loading="eager"
    />
  </div>
</Layout>
