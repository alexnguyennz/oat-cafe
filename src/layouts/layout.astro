---
import "@/styles/globals.css";

import { Font, Image } from "astro:assets";
import { ClientRouter } from "astro:transitions";

import Header from "../components/header/header.astro";
import Footer from "../components/footer.astro";
import { GoogleReviewsModal } from "@/components/google-reviews-modal.tsx";
import { cn } from "@heroui/react";

interface Props {
  title: string;
  full?: boolean;
}

const { title, full } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />

    <title>{title} — Oat Café</title>

    <meta name="description" content="Oat Cafe" />
    <meta
      name="keywords"
      content="cafe, wellington, new zealand, nz, akau, tangi, Akau Tangi Sports Centre, vegan, kid, friendly"
    />
    <meta name="viewport" content="width=device-width" />

    <slot name="head" />

    <Font cssVariable="--font-league-spartan" />
    <Font cssVariable="--font-literata" />
    <Font cssVariable="--font-luxurious-script" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <ClientRouter />
  </head>
  <body class="relative flex min-h-screen flex-col text-xl">
    <Header />

    <main
      transition:animate="none"
      class={cn(
        "relative mx-5 flex w-full max-w-4xl flex-col self-center rounded-3xl px-5 text-black xl:max-w-7xl flex-1 justify-center gap-6",
        full && "max-w-full xl:max-w-full justify-start px-0 gap-0",
      )}
    >
      <slot />
    </main>

    <Footer />

    <GoogleReviewsModal client:load>
      <div
        class="corner absolute right-0 bottom-0 size-34 overflow-hidden bg-white sm:size-36 md:size-48"
      >
        <Image
          id="logo"
          src={import("../assets/img/google-reviews.png")}
          width="550"
          alt="Google Reviews logo"
          class="absolute right-0 bottom-0 z-10 size-24 -rotate-45 object-contain duration-300 md:size-32"
          loading="eager"
        />
      </div>
    </GoogleReviewsModal>

    <style>
      .corner {
        clip-path: polygon(100% 100%, 0 100%, 100% 0);
        transform: translateZ(0);
        backface-visibility: hidden;
      }

      .corner::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: linear-gradient(
          to bottom right,
          black 50%,
          transparent 50%
        );
        background-size: 200% 200%;
        background-position: 100% 100%;
        background-repeat: no-repeat;
        transition: background-position 0.4s ease;
        z-index: 1;
      }

      .corner:hover::before,
      button:hover .corner::before {
        background-position: 0% 0%;
      }
    </style>
  </body>
</html>
